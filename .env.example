# Google AI Studio key: https://aistudio.google.com/apikey
# Without it the app runs in CACHED mode using three synthetic prescriptions.
GEMINI_API_KEY=

# Optional: pin the exact Gemma model id. If unset, the app discovers it via
# ListModels at startup and logs the choice.
# Gemma 4 candidates on the Gemini API: gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL=

PORT=3000