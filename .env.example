# Google AI Studio key: https://aistudio.google.com/apikey
# Without it the app runs in CACHED mode using three synthetic prescriptions.
GEMINI_API_KEY=

# Optional: pin a Gemma model id. If unset, the app discovers Gemma models via
# ListModels at startup and logs the choice.
# Verified on this project: gemma-4-26b-a4b-it answers reliably and supports
# JSON response mode; gemma-4-31b-it has been returning 500s from the API.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: Sarvam AI (an MLH event sponsor) key for voice in/out on MediPilot.
# MediPilot works fully in text mode without it.
SARVAM_API_KEY=

PORT=3000

# Sarvam AI: https://console.sarvam.ai/api-keys
# Voice in/out for the MediPilot copilot (Saaras STT · Bulbul TTS, hi/ta/kn/en).
# Without it MediPilot stays fully functional in text mode.
SARVAM_API_KEY=

# Cognee Cloud memory for MediPilot (see skills/cognee/SKILL.md).
# Copy both values from the Cognee Cloud console: Integrations → API / MCP → Step 1.
# Without them, memory falls back to data/medipilot-memory.json (still persistent,
# just not a graph) and the UI badge shows `memory: local`.
# The app pings {COGNEE_BASE_URL}/api/v1/datasets/ before any memory call and
# never writes to a tenant that fails the ping.
COGNEE_BASE_URL=
COGNEE_API_KEY=

COGNEE_DATASET=default_dataset